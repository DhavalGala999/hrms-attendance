# Easiest: run install.sh (macOS) or install.ps1 (Windows), which writes .env for you.
# Manual setup: copy to .env and fill in. Keep .env private (chmod 600 .env).

# Your company's Frappe HRMS address
HRMS_URL=https://hrms.yourcompany.com

# Option A — API keys (only if an admin/System Manager generates them for you)
HRMS_API_KEY=
HRMS_API_SECRET=

# Option B — your login. The password is NOT stored here; it's read from the OS credential store.
# Store it once (each prompts for the password):
#   macOS:   security add-generic-password -s hrms-attendance -a you@yourcompany.com -w
#   Windows: pip install keyring
#            python -m keyring set hrms-attendance you@yourcompany.com
HRMS_USER=you@yourcompany.com

# Days you go to office → filed as "On Duty". All other WORK_DAYS → "Work From Home".
# Names or numbers (1=Mon ... 7=Sun). Leave empty if you're fully remote.
OFFICE_DAYS=

# Your usual in/out time (24h, HH:MM). Fills the Start/End Time fields if your
# HRMS's Attendance Request form has them; otherwise ignored.
IN_TIME=10:30
OUT_TIME=19:30

# Optional note added to every request
ATTENDANCE_EXPLANATION=

# Days you work. Company holiday list is also checked when readable.
WORK_DAYS=Mon,Tue,Wed,Thu,Fri

# Popup when today's draft is created (false = only failures show a popup)
NOTIFY=true
